{
  "name": "tattle",
  "productName": "Tattle",
  "version": "1.0.0",
  "description": "Live conversation transcript, Jev timeline, and fact-checker, as a Mac app",
  "license": "BSD-3-Clause",
  "author": "Cloudless Consulting Pty Ltd <nic@cloudlesslabs.com>",
  "private": true,
  "type": "module",
  "main": "dist/desktop/main.mjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json --noEmit",
    "models": "sh scripts/download-models.sh",
    "fixtures": "node --import tsx scripts/make-fixtures.ts",
    "smoke": "node --env-file-if-exists=.env --import tsx src/cli/smoke.ts",
    "replay": "node --env-file-if-exists=.env --import tsx src/cli/replay.ts",
    "serve": "npm run build:web && node --env-file-if-exists=.env --import tsx src/server/main.ts",
    "preflight": "node --env-file-if-exists=.env --import tsx src/cli/preflight.ts",
    "calibrate:boundary": "node --import tsx src/cli/calibrateBoundary.ts",
    "calibrate:speakers": "node --env-file-if-exists=.env --import tsx src/cli/calibrateSpeakers.ts",
    "build:capture": "swift build -c release --package-path native/capture",
    "build:transcribe": "swift build -c release --package-path native/transcribe",
    "capture:test": "sh scripts/capture-test.sh",
    "transcribe:test": "sh scripts/transcribe-test.sh",
    "build:web": "tsc -p web/tsconfig.json",
    "build:desktop": "esbuild desktop/main.ts --bundle --platform=node --format=esm --target=node24 --sourcemap --log-level=warning --external:electron --external:electron-updater --external:sherpa-onnx-node --outfile=dist/desktop/main.mjs && esbuild desktop/preload.ts --bundle --platform=node --format=cjs --target=node24 --log-level=warning --external:electron --outfile=dist/desktop/preload.cjs",
    "app": "npm run build:web && npm run build:desktop && electron .",
    "dist:mac": "sh scripts/build-mac.sh",
    "notices": "node scripts/third-party-notices.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "sherpa-onnx-node": "^1.13.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
