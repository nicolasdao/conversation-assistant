{
  "server": { "port": 4317 },
  "budget": { "sessionCapUsd": 10, "devCapUsd": 3 },
  "vad": { "threshold": 0.5, "minSpeechDuration": 0.25, "minSilenceDuration": 0.5, "maxSpeechDuration": 30 },
  "echoGate": { "mode": "auto", "thresholdDbfs": -45, "holdMs": 250 },
  "speakers": { "threshold": 0.65, "minEmbedSeconds": 1.5, "maxEmbeddingsPerSpeaker": 20, "voicesPerStream": { "host": 1, "remote": 2 } },
  "transcription": {
    "model": "gpt-transcribe", "languages": ["en"], "concurrency": 4, "timeoutMs": 20000,
    "prompt": "A live, casual English-language conversation recorded for a podcast. It often covers AI, tech and marketing.",
    "keywords": ["Jev", "TypeSafe", "OpenRouter", "Riverside", "GPT-6 Luna", "GPT-6 Sol", "OpenAI", "Anthropic",
                 "Claude", "DeepSeek", "Gemini", "Hugging Face", "Nvidia", "System 1", "System 2", "Kahneman"],
    "fixes": [],
    "live": { "enabled": true, "model": "gpt-live-transcribe", "delay": "low", "prerollMs": 600, "hangoverMs": 700,
              "usdPerMinute": 0.017 },
    "apple": { "locale": "en-US", "clipPadMs": 300, "clipConcurrency": 2, "clipTimeoutMs": 20000 }
  },
  "jev": { "model": "typesafe/jev-1.13", "utteranceTimeoutMs": 3000, "segmentTimeoutMs": 5000, "maxAttempts": 2,
           "backgroundTimeoutMs": 30000, "backgroundMaxAttempts": 5, "concurrency": 8, "segmentConcurrency": 4,
           "provider": { "data_collection": "deny" } },
  "segmentation": { "boundaryThreshold": 0.6, "speakerChangeGapMs": 1500, "speakerChangeBonus": 0.1,
                    "minSegmentMs": 12000, "maxSegmentMs": 75000, "reorderTimeoutMs": 8000,
                    "pauseBoundaryMs": 2000 },
  "s2": { "model": "openai/gpt-6-luna",
          "provider": { "order": ["openai"], "allow_fallbacks": false, "require_parameters": true, "data_collection": "deny" },
          "web": { "engine": "exa", "max_results": 5 },
          "effort": { "research": "medium", "audit": "low", "rewrite": "medium" },
          "timeoutMs": 90000, "maxAttempts": 2, "researchConcurrency": 2, "maxResearchPerHour": 30, "maxResearchPerSession": 40,
          "staleAfterMs": 600000 },
  "factcheck": { "hedgedThreshold": 0.6, "knownMatchThreshold": 0.6, "maxKnownQuestions": 40,
                 "auditIntervalMs": 300000, "auditMinUtterances": 10, "auditSample": 10,
                 "rewriteOnFalseAlarms": 3, "rewriteOnMisses": 2, "rewriteCooldownMs": 180000, "replayMaxItems": 300 },
  "labelsAssist": { "model": "openai/gpt-6-luna", "effort": "medium",
                   "provider": { "order": ["openai"], "allow_fallbacks": false, "require_parameters": true, "data_collection": "deny" },
                   "timeoutMs": 90000, "maxAttempts": 2, "capUsd": 1 },
  "chat": { "defaultModel": "openai/gpt-6-luna",
            "models": ["openai/gpt-6-luna", "openai/gpt-6-sol", "openai/gpt-6-astra",
                       "anthropic/claude-sonnet-5", "anthropic/claude-opus-5.5", "anthropic/claude-fable-5.1",
                       "google/gemini-3.8-flash", "x-ai/grok-4.7", "deepseek/deepseek-v4.1-flash", "moonshotai/kimi-k3",
                       "qwen/qwen3.8-max-prime", "z-ai/glm-5.3", "meta/muse-spark-1.3", "mistralai/mistral-large-2512"],
            "provider": { "data_collection": "deny" },
            "effort": "low", "capUsd": 2, "timeoutMs": 120000, "maxAttempts": 2 }
}
